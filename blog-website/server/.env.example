# Environment Variables Template
# Copy this to .env and fill with your values

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Local MongoDB
MONGODB_URI=mongodb://localhost:27017/blog_website

# MongoDB Atlas (replace with your connection string)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/blog_website

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_use_a_strong_random_string

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8000

# Email Configuration (optional, for future use)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# Cloud Storage (optional, for image uploads)
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# AWS_S3_BUCKET=your_bucket_name

# File Upload Limits
MAX_FILE_SIZE=5242880  # 5MB in bytes

# Session Configuration
SESSION_TIMEOUT=86400000  # 24 hours in milliseconds

# Redis Configuration (optional, for caching)
# REDIS_URL=redis://localhost:6379

# API Rate Limiting (optional)
# RATE_LIMIT_WINDOW=900000  # 15 minutes
# RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug

# Features Flags
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_DARK_MODE=true
ENABLE_SOCIAL_SHARING=true
